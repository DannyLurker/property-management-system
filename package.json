{
  "name": "pms-monorepo",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "prisma:deploy": "dotenv -e .env -- pnpm --filter @pms/db exec prisma migrate deploy",
    "prisma:migrate-dev": "dotenv -e .env -- pnpm --filter @pms/db exec prisma migrate dev",
    "prisma:generate": "dotenv -e .env -- pnpm --filter @pms/db exec prisma generate",
    "prisma:studio": "dotenv -e .env -- pnpm --filter @pms/db exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
